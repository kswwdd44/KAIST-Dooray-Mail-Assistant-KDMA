{
  "manifest_version": 3,
  "name": "KAIST Dooray Mail Assistant for Chrome",
  "version": "3.17.3",
  "description": "Google Chrome에서 사용하는 Gemini 기반 KAIST Dooray 메일 답변 도우미입니다. Sunwook Kim이 만들었으며 공식 제품이 아닙니다.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.gov-dooray.com/*",
    "https://*.dooray.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gov-dooray.com/*",
        "https://*.dooray.com/*"
      ],
      "js": ["mail-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KAIST Dooray Mail Assistant for Chrome 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
